  onay:      '<polyline points="20 6 9 17 4 12"/>',
  oynat:     '<polygon points="6 3 20 12 6 21 6 3"/>',
};
const ic = ikonlar[name] ?? '';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ic}
></svg>
