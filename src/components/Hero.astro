---
// HERO — tam ekran fotoğraf + koyulaştırıcı degrade + isimler + tarih.
// Fotoğrafta çok yavaş "Ken Burns" zoom efekti.
import type { Foto } from '../data/types';
import Icon from './Icon.astro';
interface Props {
  isimler: string;
  altBaslik: string;
  tarihMetni: string;
  foto: Foto;
}
const { isimler, altBaslik, tarihMetni, foto } = Astro.props;

// Hero'da süzülen yapraklar (ambient dekor)
const yapraklar = Array.from({ length: 10 });
---

<header class="hero">
  <div class="hero-foto duo">
    <img src={foto.src} alt={foto.alt} loading="eager" fetchpriority="high" />
  </div>
  <div class="petaller" aria-hidden="true">
    {yapraklar.map((_, i) => (
      <span
        class="petal-dus"
        style={`left:${(i * 11 + 4) % 96}%; animation-delay:${(i * 0.9).toFixed(1)}s; animation-duration:${9 + (i % 4)}s; --b:${8 + (i % 3) * 3}px`}
      ></span>
    ))}
  </div>
  <div class="hero-ic">
    <p class="hero-ust">{altBaslik}</p>
    <h1 class="hero-isim">{isimler}</h1>
    <span class="hero-cizgi" aria-hidden="true"></span>
    <p class="hero-tarih">{tarihMetni}</p>
  </div>
  <span class="hero-ok" aria-hidden="true"><Icon name="ok-asagi" size={28} /></span>
</header>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
    scroll-snap-align: start;
  }
  .hero-foto {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .hero-foto img {
    animation: kenburns 26s ease-in-out infinite alternate;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(20, 30, 25, 0.92) 0%,
      rgba(20, 30, 25, 0.35) 45%,
      rgba(20, 30, 25, 0.15) 100%
    );
  }
  .hero-ic {
    text-align: center;
    padding: 0 24px 118px;
    display: grid;
    justify-items: center;
    gap: 14px;
    position: relative;
    z-index: 2;
    animation: belir 1.3s .2s ease both;
  }
  .hero-ust {
    letter-spacing: 0.34em;
    text-transform: uppercase;
    font-size: 0.74rem;
    color: var(--sage);
    margin: 0;
  }
  .hero-isim {
    font-size: clamp(2.6rem, 15vw, 4.2rem);
    color: var(--ivory);
    text-shadow: 0 2px 30px rgba(0,0,0,.35);
  }
  .hero-cizgi {
    width: 46px;
    height: 1px;
    background: var(--clay);
  }
  .hero-tarih {
    margin: 0;
    font-size: 0.98rem;
    letter-spacing: 0.04em;
    color: var(--ivory);
  }
  .hero-ok {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--ivory);
    opacity: 0.75;
    z-index: 2;
    animation: zipla 2s ease-in-out infinite;
  }

  @keyframes kenburns {
    from { transform: scale(1);    transform-origin: 50% 40%; }
    to   { transform: scale(1.14); transform-origin: 55% 55%; }
  }
  @keyframes belir {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes zipla {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(7px); }
  }
  .petaller {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }
  .petal-dus {
    position: absolute;
    top: -10%;
    width: var(--b);
    height: calc(var(--b) * 1.15);
    background: linear-gradient(var(--clay-2), var(--clay));
    border-radius: 50% 0 50% 50%;
    opacity: 0.55;
    animation-name: dus;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }
  @keyframes dus {
    0%   { transform: translateY(0) rotate(0deg); opacity: 0; }
    12%  { opacity: 0.6; }
    100% { transform: translateY(112svh) translateX(46px) rotate(320deg); opacity: 0.12; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-foto img, .hero-ic, .hero-ok { animation: none; }
    .petaller { display: none; }
  }
</style>
