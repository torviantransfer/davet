---
// SABİT ALT ÇUBUK — ekranın altında hep duran iki buton.
import Icon from './Icon.astro';
interface Props {
  haritaLinki: string;
}
const { haritaLinki } = Astro.props;
---

<nav class="altbar" aria-label="Hızlı işlemler">
  <a class="altbar-btn" href={haritaLinki} target="_blank" rel="noopener">
    <Icon name="yon" size={18} />
    Yol Tarifi
  </a>
  <a class="altbar-btn altbar-btn--dolu" href="#katilim">
    <Icon name="kalem" size={18} />
    Katılım Bildir
  </a>
</nav>

<style>
  .altbar {
    position: fixed;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: 100%;
    max-width: var(--max);
    z-index: 90;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: rgba(20, 30, 25, 0.82);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(143,166,142,.18);
  }
  .altbar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    height: 48px;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--ivory);
    border: 1.5px solid var(--sage);
    transition: transform .15s ease, background .15s ease;
  }
  .altbar-btn:active { transform: scale(0.97); }
  .altbar-btn--dolu {
    background: var(--clay);
    border-color: var(--clay);
    color: #fff;
  }
  .altbar-ikon { font-size: 1rem; }
</style>
