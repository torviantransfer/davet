---
import type { Davetiye } from '../data/types';
import Opening from '../components/Opening.astro';
import Hero from '../components/Hero.astro';
import Countdown from '../components/Countdown.astro';
import Invite from '../components/Invite.astro';
import Timeline from '../components/Timeline.astro';
import Gallery from '../components/Gallery.astro';
import Venue from '../components/Venue.astro';
import Rsvp from '../components/Rsvp.astro';
import Footer from '../components/Footer.astro';
import StickyBar from '../components/StickyBar.astro';
import '../styles/global.css';

interface Props {
  dav: Davetiye;
}
const { dav } = Astro.props;

// WhatsApp/sosyal önizleme için TAM adres üret (og:url, og:image mutlak olmalı).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const etkinlikAdi = `${dav.isimler} ${dav.etkinlikTuru}`;
// Kart başlığı ve otomatik üretilen kart görseli (/og/<slug>.png)
const kartBaslik = `${dav.isimler} · ${dav.etkinlikTuru} Davetiyesi`;
const ogKart = new URL(`/og/${dav.slug}.png`, Astro.site).href;
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{dav.ogBaslik}</title>
  <meta name="description" content={dav.ogAciklama} />

  <!-- ════════════════════════════════════════════════════════════════
       WHATSAPP / SOSYAL MEDYA ÖNİZLEME KARTI  (Open Graph)
       ----------------------------------------------------------------
       Link paylaşıldığında çıplak adres yerine GÖRSELLİ kart çıkar.
       Değiştirmen gerekenler HEP veri dosyasında (src/data/...):
         • ogBaslik   -> kartın başlığı
         • ogAciklama -> kartın açıklaması
         • ogGorsel   -> 1200x630 px görsel (TAM https adres olmalı!)
       Ayrıca astro.config.mjs içindeki "site" adresini kendi
       Vercel adresinle değiştirmeyi UNUTMA (yoksa og:url/og:image bozulur).
       ════════════════════════════════════════════════════════════════ -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={kartBaslik} />
  <meta property="og:description" content={dav.ogAciklama} />
  <meta property="og:image" content={ogKart} />
  <meta property="og:image:secure_url" content={ogKart} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={kartBaslik} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="tr_TR" />
  <meta property="og:site_name" content={etkinlikAdi} />

  <!-- Twitter/X kartı (bonus) -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={kartBaslik} />
  <meta name="twitter:description" content={dav.ogAciklama} />
  <meta name="twitter:image" content={ogKart} />

  <!-- Tarayıcı üst çubuğu rengi -->
  <meta name="theme-color" content={dav.temaRengi} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fontlar: Fraunces (başlık) + Manrope (gövde) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Manrope:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  />
</head>
<body>
  <main class="sayfa">
    <Opening monogram={dav.monogram} etkinlikTuru={dav.etkinlikTuru} muzikSrc={dav.muzikSrc} />
    <Hero isimler={dav.isimler} altBaslik={dav.altBaslik} tarihMetni={dav.tarihMetni} foto={dav.heroFoto} />
    <Countdown tarihISO={dav.tarihISO} />
    <Invite metin={dav.davetMetni} isimler={dav.isimler} />
    <Timeline program={dav.program} />
    <Gallery galeri={dav.galeri} />
    <Venue
      mekanAdi={dav.mekanAdi}
      mekanAdres={dav.mekanAdres}
      haritaLinki={dav.haritaLinki}
      tarihISO={dav.tarihISO}
      bitisISO={dav.bitisISO}
      baslik={etkinlikAdi}
    />
    <Rsvp whatsappNumara={dav.whatsappNumara} etkinlikAdi={etkinlikAdi} />
    <Footer isimler={dav.isimler} tarihMetni={dav.tarihMetni} monogram={dav.monogram} />
    <StickyBar haritaLinki={dav.haritaLinki} />
  </main>

  <!-- Kaydırınca bölümlerin belirmesi (ölçülü animasyon) -->
  <script>
    const gozlemci = new IntersectionObserver(
      (girisler) => {
        girisler.forEach((g) => {
          if (g.isIntersecting) {
            g.target.classList.add('gorundu');
            gozlemci.unobserve(g.target);
          }
        });
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach((el) => gozlemci.observe(el));
  </script>
</body>
</html>
